CONFIG_IDF_TARGET="esp32p4"

# Match the known-good ESP32-P4 hardware configuration in ../helloworld.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_AUDIO_DIAGNOSTICS_QUIET_WHILE_STREAMING=y

# The module fitted to the target board has a 16 MiB SPI flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Audio tasks use 2 ms and 5 ms waits, so the 100 Hz hello-world tick cannot
# be copied safely. Keep a 1 ms RTOS tick for deterministic audio scheduling.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Persistent array steering/PHAT statistics and audio FIFOs use external RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="src/partitions.csv"
CONFIG_ARRAY_RADIUS_MM=56
CONFIG_ARRAY_DOA_ROTATION_SPEED_DEG_PER_SEC=30
CONFIG_ARRAY_AEC_REFERENCE_DELAY_MS=0
CONFIG_ARRAY_AGC_GAIN_DB=20
CONFIG_ARRAY_POST_NS_MIN_GAIN_PERCENT=25
CONFIG_ARRAY_VAD_MIN_SPEECH_MS=128
CONFIG_ARRAY_VAD_MIN_NOISE_MS=1000
CONFIG_ARRAY_CAPTURE2_AEC_OUTPUT=y
CONFIG_ARRAY_CAPTURE2_RIGHT_VAD=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y

# Same FP32 MFCC + INT16 backend as the validated DS-TC-ResNet project.
CONFIG_KWS_INPUT_NSCORE=y
CONFIG_KWS_INTERNAL_TENSOR_KB=256
CONFIG_KWS_FILTER_STABLE_FRAMES=3
CONFIG_KWS_FILTER_NEED_VAD_CHECKED_NO=y
CONFIG_KWS_FILTER_KEYWORD_THRESHOLD_PERCENT=80
CONFIG_KWS_FILTER_COOLDOWN_MS=500

# ESP32-P4-Function-EV-Board J1 external audio interfaces.
# These GPIOs avoid the board's USB, boot-strap, UART, ESP32-C6 SDIO,
# LCD-control and on-board ES8311 audio connections.
# RX: external 8-channel TDM input, ESP32-P4 is the clock master.
CONFIG_USB_AUDIO_RX_I2S_PORT=0
CONFIG_USB_AUDIO_RX_MCLK_GPIO=20
CONFIG_USB_AUDIO_RX_BCLK_GPIO=21
CONFIG_USB_AUDIO_RX_WS_GPIO=22
CONFIG_USB_AUDIO_RX_DIN_GPIO=23
# TX: external stereo I2S output, ESP32-P4 is the clock master.
CONFIG_USB_AUDIO_TX_I2S_PORT=1
CONFIG_USB_AUDIO_TX_MCLK_GPIO=32
CONFIG_USB_AUDIO_TX_BCLK_GPIO=33
CONFIG_USB_AUDIO_TX_WS_GPIO=46
CONFIG_USB_AUDIO_TX_DOUT_GPIO=47

# 50-pixel WS2812B chain driven by the ESP32-P4 RMT TX peripheral and GDMA.
CONFIG_WS2812_LED_RING_ENABLE=y
CONFIG_WS2812_GPIO=26
CONFIG_WS2812_LED_COUNT=50
CONFIG_WS2812_LED_RING_FPS=100
CONFIG_WS2812_LED_RING_BRIGHTNESS=20
CONFIG_WS2812_LED_AUDIO_THRESHOLD_DB=-45
CONFIG_WS2812_LED_KEYWORD_DURATION_MS=1000
CONFIG_WS2812_LED_RING_TASK_PRIORITY=3
CONFIG_WS2812_LED_RING_TASK_STACK_SIZE=4096

# Keep USB isochronous service alive during custom HID model flash writes.
# Runtime VAD/KWS assets are copied to PSRAM instead of persistent flash mmap.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
